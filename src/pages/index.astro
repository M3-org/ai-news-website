---
import NewspaperLayout from '../layouts/NewspaperLayout.astro';
import Masthead from '../components/daily/Masthead.astro';
import LeadStory from '../components/daily/LeadStory.astro';
import KeyFacts from '../components/daily/KeyFacts.astro';
import DailySidebar from '../components/daily/DailySidebar.astro';
import CategoryBox from '../components/daily/CategoryBox.astro';
import StrategyBox from '../components/daily/StrategyBox.astro';
import CouncilSection from '../components/daily/CouncilSection.astro';
import DevelopmentGrid from '../components/daily/DevelopmentGrid.astro';
import FullStories from '../components/daily/FullStories.astro';
import OpenQuestions from '../components/daily/OpenQuestions.astro';
import GitHubStatsBar from '../components/daily/GitHubStatsBar.astro';
import { getFacts, getCouncilBriefing, getHighlights, getAiNews, getGitHubSummary, getGitHubStats, getDailySilk, getLatestDate, getAvailableDates } from '../lib/data-loader';

// Fetch latest episodes from M3TV
let episodes: Array<{ date: string; title: string; thumbnail: string; url: string }> = [];
try {
  const res = await fetch('https://www.m3org.com/tv/data/cronjob-episodes.json');
  if (res.ok) {
    const data = await res.json() as Record<string, Record<string, { title?: string; thumbnail?: string; url?: string }>>;
    episodes = Object.entries(data)
      .sort(([a], [b]) => b.localeCompare(a))
      .slice(0, 4)
      .map(([d, langs]) => {
        const ep = langs.en || Object.values(langs)[0] || {};
        return { date: d, title: ep.title || d, thumbnail: ep.thumbnail || '', url: ep.url || '' };
      });
  }
} catch { /* build continues without episodes */ }

const date = getLatestDate('facts');
const allDates = getAvailableDates('facts');
const dateIdx = allDates.indexOf(date);
const prevDate = dateIdx < allDates.length - 1 ? allDates[dateIdx + 1] : null;
const recentDates = allDates.slice(1, 8).reverse(); // oldest to newest (left to right)
const facts = getFacts(date);
const councilBriefing = getCouncilBriefing(date);
const highlights = getHighlights(date);
const aiNews = getAiNews(date);
const githubSummary = getGitHubSummary(date);
const githubStats = getGitHubStats(date);
const dailySilk = getDailySilk(date);

if (!facts) {
  return Astro.redirect('/gallery');
}

const ogImage = `https://elizaos.news/media/daily/${date}/overall.png`;
const description = facts.overall_summary?.substring(0, 160) || 'Daily Intelligence from the elizaOS Ecosystem';

const categories = facts.categories || {} as any;

const twitterItems = (categories.twitter_news_highlights || []).map((item: any) => ({
  text: item?.claim || '',
  source: item?.source || '',
}));

const discordItems = (categories.discord_updates || []).map((item: any) => ({
  headline: `#${item?.channel || 'unknown'}`,
  text: item?.summary || '',
  meta: Array.isArray(item?.key_participants) ? `Participants: ${item.key_participants.join(', ')}` : '',
}));

const feedbackItems = (categories.user_feedback || []).map((item: any) => ({
  text: item?.feedback_summary || '',
  source: item?.source || '',
  badge: item?.sentiment ? `badge-${item.sentiment}` : undefined,
  badgeText: item?.sentiment || undefined,
}));

const keyFacts = facts.key_facts || [];
---
<NewspaperLayout title="elizaOS News" description={description} ogImage={ogImage} active="home">
  <Masthead date={date} latestDate={date} />

  <LeadStory summary={facts.overall_summary || ''} sentiment={facts.tags?.sentiment?.overall} date={date} themes={facts.tags?.themes} />

  <KeyFacts facts={keyFacts} />

  {(facts.open_questions?.length ?? 0) > 0 && (
    <OpenQuestions questions={facts.open_questions} />
  )}

  {dailySilk && <DailySidebar dailySilk={dailySilk} />}

  <div class:list={['grouped-sections', 'full-width']}>
    <div class="section-column">
      {twitterItems.length > 0 && (
        <CategoryBox title="Twitter News" items={twitterItems} categoryImage={`/media/daily/${date}/twitter-news.png`} categoryType="twitter" />
      )}
      {discordItems.length > 0 && (
        <CategoryBox title="Discord Updates" items={discordItems} categoryImage={`/media/daily/${date}/discord-updates.png`} categoryType="discord" />
      )}
    </div>
    <div class="section-column">
      {categories.strategic_insights?.length > 0 && (
        <StrategyBox title="Strategic Insights" items={categories.strategic_insights} categoryImage={`/media/daily/${date}/strategic-insights.png`} />
      )}
      {categories.market_analysis?.length > 0 && (
        <StrategyBox title="Market Analysis" items={categories.market_analysis} categoryImage={`/media/daily/${date}/market-analysis.png`} />
      )}
      {feedbackItems.length > 0 && (
        <CategoryBox title="User Feedback" items={feedbackItems} categoryType="feedback" />
      )}
    </div>
  </div>

  <hr class="rule-double full-width" />

  <CouncilSection highlights={highlights} councilBriefing={councilBriefing} date={date} />

  <hr class="rule-double full-width" />

  {githubStats && <GitHubStatsBar stats={githubStats} />}

  <DevelopmentGrid
    githubItems={categories.github_updates?.new_issues_prs || []}
    githubSummary={githubSummary}
    date={date}
  />

  <hr class="rule-double full-width" />

  <FullStories aiNews={aiNews} date={date} />

  {episodes.length > 0 && (
    <section class="latest-episodes full-width">
      <h2 class="section-title">Latest Episodes</h2>
      <div class="episodes-grid">
        {episodes.map(ep => (
          <a href={ep.url} target="_blank" rel="noopener" class="episode-card">
            <img src={ep.thumbnail} alt={ep.title} class="episode-thumb" loading="lazy" />
            <div class="episode-info">
              <div class="episode-date">{ep.date}</div>
              <div class="episode-title">{ep.title}</div>
            </div>
          </a>
        ))}
      </div>
      <a href="https://www.m3org.com/tv/shows/cronjob.html" target="_blank" rel="noopener" class="section-cta">All episodes on M3TV &rarr;</a>
    </section>
  )}

  <nav class="date-archive full-width">
    <div class="archive-label">Previous Editions</div>
    <div class="archive-dates">
      {recentDates.map(d => (
        <a href={`/daily/${d}`} class="archive-date">{d}</a>
      ))}
    </div>
    {prevDate && (
      <a href={`/daily/${prevDate}`} class="archive-older">&larr; Previous day</a>
    )}
  </nav>
</NewspaperLayout>

<style>
  .date-archive {
    border-top: 2px solid var(--np-border-heavy, #121212);
    padding-top: 1.5rem;
    margin-top: 3rem;
    text-align: center;
  }

  .archive-label {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--np-text, #121212);
  }

  .archive-dates {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .archive-date {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8125rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--np-border, #ddd);
    border-radius: 2px;
    color: var(--np-text-muted, #666);
    transition: all 0.15s;
  }

  .archive-date:hover {
    border-color: var(--np-border-heavy, #121212);
    color: var(--np-text, #121212);
  }

  .archive-older {
    font-size: 0.8125rem;
    color: var(--np-text-muted, #666);
    transition: color 0.15s;
  }

  .archive-older:hover {
    color: var(--np-text, #121212);
  }

  /* Latest Episodes */
  .latest-episodes {
    margin-top: 2rem;
  }

  .episodes-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .episode-card {
    text-decoration: none;
    color: var(--np-text, #121212);
    border: 1px solid var(--np-border-light, #eee);
    border-radius: 4px;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .episode-card:hover {
    border-color: var(--np-border-heavy, #121212);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .episode-thumb {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    display: block;
  }

  .episode-info {
    padding: 0.75rem;
  }

  .episode-date {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--np-text-muted, #666);
    margin-bottom: 0.25rem;
  }

  .episode-title {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .episodes-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
