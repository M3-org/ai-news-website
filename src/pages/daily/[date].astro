---
import NewspaperLayout from '../../layouts/NewspaperLayout.astro';
import Masthead from '../../components/daily/Masthead.astro';
import LeadStory from '../../components/daily/LeadStory.astro';
import KeyFacts from '../../components/daily/KeyFacts.astro';
import DailySidebar from '../../components/daily/DailySidebar.astro';
import CategoryBox from '../../components/daily/CategoryBox.astro';
import StrategyBox from '../../components/daily/StrategyBox.astro';
import CouncilSection from '../../components/daily/CouncilSection.astro';
import DevelopmentGrid from '../../components/daily/DevelopmentGrid.astro';
import FullStories from '../../components/daily/FullStories.astro';
import OpenQuestions from '../../components/daily/OpenQuestions.astro';
import GitHubStatsBar from '../../components/daily/GitHubStatsBar.astro';
import { getFacts, getCouncilBriefing, getHighlights, getAiNews, getGitHubSummary, getGitHubStats, getDailySilk, getAvailableDates, getLatestDate, getBroadsheetDates } from '../../lib/data-loader';

export function getStaticPaths() {
  const dates = getAvailableDates('facts');
  return dates.map(date => ({ params: { date } }));
}

const { date } = Astro.params;
const allDates = getAvailableDates('facts');
const dateIdx = allDates.indexOf(date!);
const prevDate = dateIdx < allDates.length - 1 ? allDates[dateIdx + 1] : null;
const nextDate = dateIdx > 0 ? allDates[dateIdx - 1] : null;
const recentDates = allDates.slice(0, 8).filter(d => d !== date).reverse().slice(-7);
const facts = getFacts(date!);
const councilBriefing = getCouncilBriefing(date!);
const highlights = getHighlights(date!);
const aiNews = getAiNews(date!);
const githubSummary = getGitHubSummary(date!);
const githubStats = getGitHubStats(date!);
const dailySilk = getDailySilk(date!);
const latestDate = getLatestDate('facts');

if (!facts) {
  return Astro.redirect('/');
}

const ogImage = `https://elizaos.news/media/daily/${date}/overall.png`;
const description = facts.overall_summary?.substring(0, 160) || 'Daily Intelligence from the elizaOS Ecosystem';

const categories = facts.categories || {} as any;

// Prepare community items
const twitterItems = (categories.twitter_news_highlights || []).map((item: any) => ({
  text: item?.claim || '',
  source: item?.source || '',
}));

const discordItems = (categories.discord_updates || []).map((item: any) => {
  const ch = String(item?.channel || 'unknown').replace(/^#+/, '');
  return {
    headline: `#${ch}`,
    text: item?.summary || '',
    meta: Array.isArray(item?.key_participants) ? `Participants: ${item.key_participants.join(', ')}` : '',
  };
});

const feedbackItems = (categories.user_feedback || []).map((item: any) => ({
  text: item?.feedback_summary || '',
  source: item?.source || '',
  badge: item?.sentiment ? `badge-${item.sentiment}` : undefined,
  badgeText: item?.sentiment || undefined,
}));

const keyFacts = facts.key_facts || [];
---
<NewspaperLayout title={`Daily Brief - ${date}`} description={description} ogImage={ogImage}>
  <script slot="jsonld" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    "headline": `elizaOS Daily Intelligence - ${date}`,
    "datePublished": date,
    "description": description,
    "image": ogImage,
    "publisher": {
      "@type": "Organization",
      "name": "elizaOS News",
      "url": "https://elizaos.news"
    },
    "mainEntityOfPage": `https://elizaos.news/daily/${date}`
  })} />
  <Masthead date={date!} latestDate={latestDate} />

  <LeadStory summary={facts.overall_summary || ''} sentiment={facts.tags?.sentiment?.overall} date={date!} themes={facts.tags?.themes} />

  <div class="facts-questions-row full-width">
    <KeyFacts facts={keyFacts} />
    {(facts.open_questions?.length ?? 0) > 0 && (
      <OpenQuestions questions={facts.open_questions} />
    )}
  </div>

  {dailySilk && <DailySidebar dailySilk={dailySilk} />}

  <div class:list={['grouped-sections', 'full-width']}>
    <div class="section-column">
      {twitterItems.length > 0 && (
        <CategoryBox title="X News" items={twitterItems} categoryImage={`/media/daily/${date}/twitter-news.png`} categoryType="twitter" />
      )}
      {discordItems.length > 0 && (
        <CategoryBox title='<svg width="16" height="16" viewBox="0 0 24 24" fill="#5865F2" style="vertical-align:-2px"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg> Discord Updates' items={discordItems} categoryImage={`/media/daily/${date}/discord-updates.png`} categoryType="discord" />
      )}
    </div>
    <div class="section-column">
      {categories.strategic_insights?.length > 0 && (
        <StrategyBox title="Strategic Insights" items={categories.strategic_insights} categoryImage={`/media/daily/${date}/strategic-insights.png`} />
      )}
      {categories.market_analysis?.length > 0 && (
        <StrategyBox title="Market Analysis" items={categories.market_analysis} categoryImage={`/media/daily/${date}/market-analysis.png`} />
      )}
      {feedbackItems.length > 0 && (
        <CategoryBox title="User Feedback" items={feedbackItems} categoryType="feedback" />
      )}
    </div>
  </div>

  <hr class="rule-double full-width" />

  <CouncilSection highlights={highlights} councilBriefing={councilBriefing} date={date!} />

  <hr class="rule-double full-width" />

  {githubStats && <GitHubStatsBar stats={githubStats} />}

  <DevelopmentGrid
    githubItems={categories.github_updates?.new_issues_prs || []}
    githubSummary={githubSummary}
    date={date!}
  />

  <hr class="rule-double full-width" />

  <FullStories aiNews={aiNews} date={date!} />

  <nav class="date-archive full-width">
    <div class="archive-label">Previous Editions</div>
    <div class="archive-dates">
      {recentDates.map(d => (
        <a href={`/daily/${d}`} class:list={['archive-date', { active: d === date }]}>{d}</a>
      ))}
    </div>
    <div class="archive-nav-links">
      {prevDate && <a href={`/daily/${prevDate}`} class="archive-older">&larr; Older</a>}
      {/* Broadsheet PDFs are rendered at deploy time for the 7 newest
          printable editions — same selection render-pdf.cjs makes. */}
      {getBroadsheetDates().has(date!) && (
        <a href={`/media/daily/${date}/broadsheet.pdf`} class="archive-older">Print Edition (PDF)</a>
      )}
      {nextDate && <a href={`/daily/${nextDate}`} class="archive-older">Newer &rarr;</a>}
    </div>
  </nav>
</NewspaperLayout>

<style>
  .date-archive {
    border-top: 2px solid var(--np-border-heavy, #121212);
    padding-top: 1.5rem;
    margin-top: 3rem;
    text-align: center;
  }

  .archive-label {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--np-text, #121212);
  }

  .archive-dates {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .archive-date {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8125rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--np-border, #ddd);
    border-radius: 2px;
    color: var(--np-text-muted, #666);
    transition: all 0.15s;
  }

  .archive-date:hover {
    border-color: var(--np-border-heavy, #121212);
    color: var(--np-text, #121212);
  }

  .archive-date.active {
    border-color: var(--np-border-heavy, #121212);
    color: var(--np-text, #121212);
    font-weight: 600;
  }

  .archive-nav-links {
    display: flex;
    justify-content: center;
    gap: 2rem;
  }

  .archive-older {
    font-size: 0.8125rem;
    color: var(--np-text-muted, #666);
    transition: color 0.15s;
  }

  .archive-older:hover {
    color: var(--np-text, #121212);
  }
</style>

