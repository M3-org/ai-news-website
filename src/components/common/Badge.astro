---
interface Props {
  variant?: 'positive' | 'negative' | 'mixed' | 'neutral' | 'open' | 'closed' | 'merged';
  text: string;
}

const { variant = 'neutral', text } = Astro.props;
---
<span class:list={['badge', `badge-${variant}`]}>{text}</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border-radius: 2px;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .badge-positive, .badge-open { background: #e8f5e9; color: #2e7d32; }
  .badge-negative, .badge-closed { background: #ffebee; color: #c62828; }
  .badge-mixed, .badge-merged { background: #e8eaf6; color: #283593; }
  .badge-neutral { background: #f5f5f5; color: #666; }

  :global(.dark) .badge-positive, :global(.dark) .badge-open { background: rgba(34, 197, 94, 0.1); color: #22c55e; }
  :global(.dark) .badge-negative, :global(.dark) .badge-closed { background: rgba(239, 68, 68, 0.1); color: #ef4444; }
  :global(.dark) .badge-mixed, :global(.dark) .badge-merged { background: rgba(168, 85, 247, 0.1); color: #a855f7; }
  :global(.dark) .badge-neutral { background: rgba(113, 113, 122, 0.1); color: #71717a; }
</style>
