---
interface Props {
  summary: string;
  sentiment?: string;
  date: string;
  themes?: string[];
}

const { summary, sentiment, date, themes = [] } = Astro.props;
const heroImage = `/media/daily/${date}/overall.png`;
const heroImageArchive = heroImage.replace('/media/daily/', '/archive/media/daily/');
const heroImageCdn = `https://cdn.elizaos.news${heroImage}`;
const heroImageOnError = `if(!this.dataset.fallbackStep){this.dataset.fallbackStep='archive';this.src='${heroImageArchive}';}else if(this.dataset.fallbackStep==='archive'){this.dataset.fallbackStep='cdn';this.src='${heroImageCdn}';}else{this.style.display='none';}`;
const displayThemes = themes.slice(0, 8);
---
<div class="full-width">
  <article class="daily-brief">
    <div class="lead-image-container">
      <img src={heroImage} alt="Daily briefing illustration" loading="eager" onerror={heroImageOnError} data-lightbox />
    </div>
    <div class="brief-label">
      Daily Brief
      {sentiment && <span class:list={['badge', `badge-${sentiment}`]}>{sentiment}</span>}
    </div>
    <p class="brief-text">{summary}</p>
    {displayThemes.length > 0 && (
      <div class="theme-tags">
        {displayThemes.map(theme => (
          <span class="badge badge-neutral">{theme}</span>
        ))}
      </div>
    )}
  </article>
</div>
