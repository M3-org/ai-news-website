---
import { escapeHtml } from '../../lib/dates';
import type { StrategicInsight, MarketAnalysis } from '../../lib/types';

interface Props {
  title: string;
  items: (StrategicInsight | MarketAnalysis)[];
  categoryImage?: string;
}

const { title, items, categoryImage } = Astro.props;
const type = title.toLowerCase().includes('insight') ? 'strategic' : 'market';

const categoryImageArchive = categoryImage?.startsWith('/media/daily/')
  ? categoryImage.replace('/media/daily/', '/archive/media/daily/')
  : null;
const categoryImageCdn = categoryImage?.startsWith('/media/daily/')
  ? `https://cdn.elizaos.news${categoryImage}`
  : null;
const categoryImageOnError = categoryImageArchive && categoryImageCdn
  ? `if(!this.dataset.fallbackStep){this.dataset.fallbackStep='archive';this.src='${categoryImageArchive}';}else if(this.dataset.fallbackStep==='archive'){this.dataset.fallbackStep='cdn';this.src='${categoryImageCdn}';}else{this.parentElement.style.display='none';}`
  : "this.parentElement.style.display='none'";
---
<div class="strategy-box" data-category={type}>
  {categoryImage && (
    <div class="strategy-header-image-container">
      <img src={categoryImage} alt={title} loading="lazy" onerror={categoryImageOnError} data-lightbox />
    </div>
  )}
  <h3 class="category-title">{title}</h3>
  {items.map(item => {
    const theme = 'theme' in item ? item.theme : undefined;
    const priority = 'priority' in item ? (item as any).priority : undefined;
    const text = ('insight' in item ? item.insight : undefined) || ('observation' in item ? item.observation : undefined) || item.summary || '';
    const relevance = item.relevance;
    const implications = ('implications_or_questions' in item ? item.implications_or_questions : undefined) || [];
    return (
      <div class="strategy-item">
        {theme && <span class="strategy-theme">{theme}</span>}
        {priority && <span class:list={['priority-badge', `priority-badge--${priority}`]}>{priority}</span>}
        <div>{text}</div>
        {relevance && <div class="relevance">{relevance}</div>}
        {implications.length > 0 && (
          <div class="implications">
            <div class="implications-label">Key Questions:</div>
            <ul class="implications-list">
              {implications.map(q => <li>{q}</li>)}
            </ul>
          </div>
        )}
      </div>
    );
  })}
</div>
