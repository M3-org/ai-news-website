---
import DatePicker from '../nav/DatePicker';
import { formatDateLong } from '../../lib/dates';

interface Props {
  date: string;
  latestDate: string;
}

const { date, latestDate } = Astro.props;
const formattedDate = formatDateLong(date).toUpperCase();
---
<div class="masthead full-width">
  <div class="masthead-rule"></div>
  <div class="masthead-meta">
    <span class="masthead-edition">Daily Edition</span>
    <span class="masthead-date">{formattedDate}</span>
    <span class="masthead-edition">elizaos.news</span>
  </div>
  <h1 class="newspaper-title">Eliza Times</h1>
  <p class="masthead-tagline">Daily Intelligence from the elizaOS Ecosystem</p>
  <DatePicker client:load currentDate={date} latestDate={latestDate} basePath="/daily" />
  <div class="masthead-rule-bottom"></div>
  <div class="polymarket-ticker">
    <iframe class="ticker-light" src="https://ticker.polymarket.com/embed?category=Technology&theme=light&speed=1&displayMode=classic&height=48" width="100%" height="48" frameborder="0" scrolling="no" style="border: none; overflow: hidden;"></iframe>
    <iframe class="ticker-dark" src="https://ticker.polymarket.com/embed?category=Technology&theme=dark&speed=1&displayMode=classic&height=48" width="100%" height="48" frameborder="0" scrolling="no" style="border: none; overflow: hidden;"></iframe>
  </div>
  <div class="masthead-rule-bottom"></div>
</div>
