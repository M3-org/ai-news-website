---
import { escapeHtml } from '../../lib/dates';

interface Props {
  title: string;
  items: {
    headline?: string;
    text?: string;
    meta?: string;
    badge?: string;
    badgeText?: string;
    url?: string;
    avatar?: string;
    source?: string;
  }[];
  categoryImage?: string;
  categoryType?: string;
}

const { title, items, categoryImage, categoryType = '' } = Astro.props;
const altText = title.replace(/<[^>]*>/g, '').trim();

const categoryImageArchive = categoryImage?.startsWith('/media/daily/')
  ? categoryImage.replace('/media/daily/', '/archive/media/daily/')
  : null;
const categoryImageCdn = categoryImage?.startsWith('/media/daily/')
  ? `https://cdn.elizaos.news${categoryImage}`
  : null;
const categoryImageOnError = categoryImageArchive && categoryImageCdn
  ? `if(!this.dataset.fallbackStep){this.dataset.fallbackStep='archive';this.src='${categoryImageArchive}';}else if(this.dataset.fallbackStep==='archive'){this.dataset.fallbackStep='cdn';this.src='${categoryImageCdn}';}else{this.parentElement.style.display='none';}`
  : "this.parentElement.style.display='none'";
---
<div class="category-box" data-category={categoryType}>
  {categoryImage && (
    <div class="category-header-image-container">
      <img src={categoryImage} alt={altText} class="category-header-image" loading="lazy" onerror={categoryImageOnError} data-lightbox />
    </div>
  )}
  <div class="category-content">
    <h3 class="category-title" set:html={title} />
    {items.map(item => (
      item.avatar ? (
        <div class="category-item with-avatar github-layout">
          <div class="item-main">
            {item.headline && (
              <div class="item-headline">
                {item.url ? (
                  <a href={item.url} target="_blank" rel="noopener noreferrer">{item.headline}</a>
                ) : item.headline}
              </div>
            )}
            {item.text && <div>{item.text}</div>}
            <div class="item-footer">
              {item.badge && <span class:list={['badge', item.badge]}>{item.badgeText}</span>}
            </div>
          </div>
          <div class="item-avatar-column">
            <img src={item.avatar} alt="Author avatar" class="item-avatar" loading="lazy" />
            {item.meta && <div class="item-meta-small">{item.meta}</div>}
          </div>
        </div>
      ) : (
        <div class="category-item">
          <div class="item-content">
            {item.headline && (
              <div class="item-headline">
                {item.url ? (
                  <a href={item.url} target="_blank" rel="noopener noreferrer">{item.headline}</a>
                ) : item.headline}
              </div>
            )}
            {item.text && <div>{item.text}</div>}
            {item.badge && <span class:list={['badge', item.badge]}>{item.badgeText}</span>}
            {item.meta && <div class="item-meta">{item.meta}</div>}
          </div>
        </div>
      )
    ))}
  </div>
</div>
