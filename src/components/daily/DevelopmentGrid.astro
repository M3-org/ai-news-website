---
import CategoryBox from './CategoryBox.astro';
import type { GitHubItem, GitHubStats } from '../../lib/types';

interface Props {
  githubItems: GitHubItem[];
  githubStats: GitHubStats | null;
  date: string;
}

const { githubItems, githubStats, date } = Astro.props;
const topContributors = (githubStats?.topContributors || []).slice(0, 3);

const items = githubItems.map(item => ({
  headline: `${item.title} #${item.number}`,
  text: item.significance,
  meta: `${item.item_type === 'pull_request' ? 'PR' : 'Issue'} by ${item.author}`,
  badge: `badge-${item.status}`,
  badgeText: item.status,
  url: item.url,
  avatar: `https://github.com/${item.author}.png`,
}));

const githubSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" style="vertical-align:-0.2em;margin-left:0.25rem;"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"/></svg>';
---
<div class="development-grid full-width">
  <div>
    <h2 class="section-title">Development</h2>
    {items.length > 0 && (
      <CategoryBox title={`GitHub Updates ${githubSvg}`} items={items} categoryImage={`/media/daily/${date}/github-updates.png`} categoryType="github" />
    )}
  </div>
  <div>
    {githubStats && (
      <Fragment>
        <h2 class="section-title">Activity</h2>
        <div class="github-stats-box">
          <div class="stats-grid">
            <div class="stat-item">
              <div class="stat-value">{githubStats.newPRs || 0}</div>
              <div class="stat-label">New PRs</div>
            </div>
            <div class="stat-item">
              <div class="stat-value">{githubStats.mergedPRs || 0}</div>
              <div class="stat-label">Merged</div>
            </div>
            <div class="stat-item">
              <div class="stat-value">{githubStats.newIssues || 0}</div>
              <div class="stat-label">New Issues</div>
            </div>
            <div class="stat-item">
              <div class="stat-value">{githubStats.closedIssues || 0}</div>
              <div class="stat-label">Closed</div>
            </div>
          </div>
          {topContributors.length > 0 && (
            <div class="top-contributors">
              <h4 class="contributors-title">Top Contributors</h4>
              {topContributors.map(contributor => (
                <div class="contributor-item">
                  <img src={contributor.avatarUrl} alt={contributor.username} class="contributor-avatar" loading="lazy" />
                  <div class="contributor-info">
                    <div class="contributor-name">{contributor.username}</div>
                    <div class="contributor-score">{Math.round(contributor.totalScore)} pts</div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </Fragment>
    )}
  </div>
</div>
