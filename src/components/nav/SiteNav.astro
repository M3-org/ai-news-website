---
import { getLatestDate } from '../../lib/data-loader';

interface Props {
  active?: string;
}

const { active = '' } = Astro.props;
const latestFactsDate = getLatestDate('facts');
const latestCouncilDate = getLatestDate('council_briefing');

const links = [
  { href: '/', label: 'Home', id: 'home' },
  { href: `/daily/${latestFactsDate}`, label: 'Daily', id: 'daily' },
  { href: `/council/${latestCouncilDate}`, label: 'Council', id: 'council' },
  { href: '/gallery', label: 'Gallery', id: 'gallery' },
];
---
<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-brand">elizaOS News</a>
    <div class="nav-links">
      {links.map(link => (
        <a
          href={link.href}
          class:list={['nav-link', { active: active === link.id }]}
          {...(link.id === 'rss' ? { target: '_blank' } : {})}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(250, 250, 250, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid #ddd;
    padding: 0.5rem 2rem;
    z-index: 1000;
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  }

  :global(.dark) .site-nav {
    background: rgba(9, 9, 11, 0.9);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .nav-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-brand {
    font-weight: 700;
    font-size: 0.9rem;
    color: #333;
    text-decoration: none;
    white-space: nowrap;
  }

  :global(.dark) .nav-brand {
    color: #fafafa;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .nav-link {
    color: #666;
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.2s ease;
  }

  .nav-link:hover { color: #333; }
  .nav-link.active { color: #333; font-weight: 600; }

  :global(.dark) .nav-link { color: #a1a1aa; }
  :global(.dark) .nav-link:hover { color: #fafafa; }
  :global(.dark) .nav-link.active { color: #fafafa; font-weight: 600; }

  @media (max-width: 640px) {
    .site-nav { padding: 0.5rem 1rem; }
    .nav-links { gap: 1rem; flex-wrap: wrap; }
    .nav-link { font-size: 0.8rem; }
  }
</style>
