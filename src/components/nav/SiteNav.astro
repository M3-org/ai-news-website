---
import { getLatestDate } from '../../lib/data-loader';

interface Props {
  active?: string;
}

const { active = '' } = Astro.props;
const latestFactsDate = getLatestDate('facts');
const latestCouncilDate = getLatestDate('council_briefing');

const links = [
  { href: '/gallery', label: 'Gallery', id: 'gallery' },
];
---
<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-brand">elizaOS News</a>
    <div class="nav-links">
      {links.map(link => (
        <a
          href={link.href}
          class:list={['nav-link', { active: active === link.id }]}
          {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
        >
          {link.label}
        </a>
      ))}
    </div>
    <div class="nav-right">
      <a href="https://www.youtube.com/playlist?list=PLp5K4ceh2pR0NIQEo_J1TR8fBHXRQm6MS" target="_blank" rel="noopener" class="nav-link nav-icon-link" title="YouTube">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </a>
      <a href="/rss/feed.xml" target="_blank" class="nav-link nav-icon-link" title="RSS Feed">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
        <span class="rss-label">RSS</span>
      </a>
      <button id="theme-toggle" class="theme-btn" title="Toggle theme" aria-label="Toggle light/dark theme">
        <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </div>
  </div>
</nav>

<script is:inline>
  (function() {
    const stored = localStorage.getItem('theme');
    document.body.className = stored === 'dark' ? 'dark' : 'newspaper';

    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', () => {
        const isDark = document.body.classList.contains('dark');
        document.body.className = isDark ? 'newspaper' : 'dark';
        localStorage.setItem('theme', isDark ? 'light' : 'dark');
      });
    });
  })();
</script>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(250, 250, 250, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid #ddd;
    padding: 0.5rem 2rem;
    z-index: 1000;
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
    transition: background 0.3s, border-color 0.3s;
  }

  :global(.dark) .site-nav {
    background: rgba(9, 9, 11, 0.92);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .nav-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-brand {
    font-weight: 700;
    font-size: 0.9rem;
    color: #333;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.3s;
  }

  :global(.dark) .nav-brand { color: #fafafa; }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    flex: 1;
  }

  .nav-link {
    color: #666;
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.2s ease;
  }

  .nav-link:hover { color: #333; }
  .nav-link.active { color: #333; font-weight: 600; }

  :global(.dark) .nav-link { color: #a1a1aa; }
  :global(.dark) .nav-link:hover { color: #fafafa; }
  :global(.dark) .nav-link.active { color: #fafafa; font-weight: 600; }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-left: auto;
  }

  .nav-icon-link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    min-width: 44px;
    min-height: 44px;
    justify-content: center;
  }

  .theme-btn {
    background: none;
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 0.35rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
    transition: all 0.2s;
  }

  .theme-btn:hover {
    border-color: #999;
    color: #333;
  }

  :global(.dark) .theme-btn {
    border-color: rgba(255, 255, 255, 0.15);
    color: #a1a1aa;
  }

  :global(.dark) .theme-btn:hover {
    border-color: rgba(255, 255, 255, 0.3);
    color: #fafafa;
  }

  /* Show sun in dark mode, moon in light mode */
  .icon-sun { display: none; }
  .icon-moon { display: block; }
  :global(.dark) .icon-sun { display: block; }
  :global(.dark) .icon-moon { display: none; }

  @media (max-width: 1024px) {
    .nav-inner { max-width: 100%; padding: 0 1rem; }
    .nav-link { font-size: 0.8rem; }
  }

  @media (max-width: 768px) {
    .site-nav { padding: 0.4rem 0.75rem; }
    .nav-inner { gap: 1rem; }
    .nav-links { gap: 0.75rem; }
    .nav-link { font-size: 0.78rem; }
    .nav-right { gap: 0.5rem; }
    .nav-brand { font-size: 0.82rem; }
  }

  @media (max-width: 480px) {
    .site-nav { padding: 0.4rem 0.5rem; }
    .nav-inner { gap: 0.5rem; }
    .nav-brand { font-size: 0.7rem; }
    .nav-links { gap: 0.4rem; }
    .nav-link { font-size: 0.7rem; }
    .nav-right { gap: 0.25rem; }
    /* Hide RSS label on very small screens */
    .nav-icon-link .rss-label { display: none; }
    /* Larger touch targets for icons */
    .nav-icon-link svg { width: 18px; height: 18px; }
  }
</style>
