---
import BaseLayout from './BaseLayout.astro';
import SiteNav from '../components/nav/SiteNav.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  date?: string;
}

const { title, description, ogImage, date } = Astro.props;
---
<BaseLayout title={title} description={description} ogImage={ogImage} theme="light">
  <SiteNav slot="nav" active="daily" />
  <div class="news-container">
    <slot />
  </div>
</BaseLayout>

<style is:global>
  @import '../styles/newspaper.css';
</style>
