---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  theme?: 'light' | 'dark';
}

const { title, description = 'Daily Intelligence from the elizaOS Ecosystem', ogImage, theme = 'light' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | elizaOS News</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalURL}>

  <!-- OG Tags -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  {ogImage && <meta property="og:image" content={ogImage}>}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  {ogImage && <meta name="twitter:image" content={ogImage}>}

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=IBM+Plex+Serif:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Prevent FOUC: apply theme before render -->
  <script is:inline>
    (function() {
      var s = localStorage.getItem('theme');
      var d = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.className = (s === 'dark' || (!s && d)) ? 'dark' : '';
    })();
  </script>

  <slot name="head" />
</head>
<body class={theme === 'light' ? 'newspaper' : 'dark'}>
  <slot name="nav" />
  <slot />
  <footer class="site-footer">
    <div class="footer-inner">
      <span class="footer-brand">elizaOS News</span>
      <div class="footer-links">
        <a href="/rss/feed.xml" target="_blank">RSS</a>
        <a href="https://www.youtube.com/playlist?list=PLp5K4ceh2pR0NIQEo_J1TR8fBHXRQm6MS" target="_blank" rel="noopener">YouTube</a>
        <a href="https://github.com/M3-org/ai-news-website" target="_blank" rel="noopener">GitHub</a>
        <a href="https://discord.com/invite/ai16z" target="_blank" rel="noopener">Discord</a>
        <a href="https://x.com/elizaos" target="_blank" rel="noopener" class="footer-x-link"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
        <a href="https://www.m3org.com/tv/" target="_blank" rel="noopener">M3TV</a>
        <a href="https://eliza.how/" target="_blank" rel="noopener">Docs</a>
        <a href="https://elizaos.github.io/summary/day" target="_blank" rel="noopener">HiScores</a>
        <a href="/unity/">Unity</a>
      </div>
    </div>
  </footer>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
