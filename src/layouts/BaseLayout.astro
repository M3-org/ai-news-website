---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  theme?: 'light' | 'dark';
}

const { title, description = 'Daily Intelligence from the elizaOS Ecosystem', ogImage, theme = 'light' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | elizaOS News</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalURL}>

  <!-- OG Tags -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  {ogImage && <meta property="og:image" content={ogImage}>}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  {ogImage && <meta name="twitter:image" content={ogImage}>}

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=IBM+Plex+Serif:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Prevent FOUC: apply theme before render -->
  <script is:inline>
    (function() {
      var s = localStorage.getItem('theme');
      var d = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.className = (s === 'dark' || (!s && d)) ? 'dark' : '';
    })();
  </script>

  <slot name="head" />
</head>
<body class={theme === 'light' ? 'newspaper' : 'dark'}>
  <slot name="nav" />
  <slot />
  <footer class="site-footer">
    <div class="footer-inner">
      <span class="footer-brand">elizaOS News</span>
      <div class="footer-links">
        <a href="/rss/feed.xml" target="_blank">RSS</a>
        <a href="https://www.youtube.com/@elizaos" target="_blank" rel="noopener">YouTube</a>
        <a href="https://github.com/elizaOS" target="_blank" rel="noopener">GitHub</a>
        <a href="/unity/">Unity</a>
      </div>
    </div>
  </footer>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
