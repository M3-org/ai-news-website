# AI News Website Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# OpenRouter API (for LLM clip analysis)
# ===========================================
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ===========================================
# Alerts Configuration
# ===========================================
# Discord webhook URL for recording notifications (optional)
# Get this from Discord: Server Settings > Integrations > Webhooks
ALERT_WEBHOOK_URL=

# ===========================================
# YouTube Upload Configuration
# ===========================================
# See setup_youtube_auth.py for OAuth setup instructions

# YouTube playlist ID to add uploaded videos to (optional)
# Extract from URL: youtube.com/playlist?list=PLxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_PLAYLIST_ID=

# ===========================================
# Bunny CDN Configuration
# ===========================================
# Required for cdn_upload.py

# Your Bunny storage zone name
BUNNY_STORAGE_ZONE=

# Your Bunny API password (from Storage Zone settings)
BUNNY_STORAGE_PASSWORD=

# Your CDN URL (custom domain or Bunny CDN URL)
# Example: https://cdn.elizaos.news or https://your-zone.b-cdn.net
BUNNY_CDN_URL=

# Storage host region (optional, defaults to LA)
# Options: https://la.storage.bunnycdn.com (default)
#          https://ny.storage.bunnycdn.com
#          https://sg.storage.bunnycdn.com
#          https://uk.storage.bunnycdn.com
#          https://de.storage.bunnycdn.com
# BUNNY_STORAGE_HOST="https://la.storage.bunnycdn.com"

# ===========================================
# Discord Bot Configuration (for rich notifications)
# ===========================================
# Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Channel ID to post notifications to (right-click channel > Copy Channel ID)
DISCORD_NOTIFY_CHANNEL_ID=

# Role ID allowed to click Publish/Cancel (right-click role > Copy Role ID)
# If unset, anyone in the channel can click the buttons
# DISCORD_PUBLISH_ROLE_ID=

# Auto-publish timeout in seconds (default: 86400 = 24h)
# DISCORD_PUBLISH_TIMEOUT=86400

# ===========================================
# Publishing Configuration
# ===========================================
# Publishing targets for run_pipeline.sh (space-separated for multiple)
# Single target: PUBLISH_TARGETS=m3tv
# Dual publishing: PUBLISH_TARGETS="m3tv ftp"
# FTP only: PUBLISH_TARGETS=ftp
PUBLISH_TARGETS=m3tv

# Legacy single target (for backward compatibility, use PUBLISH_TARGETS instead)
# PUBLISH_TARGET=m3tv

# Website repo path (required for --target=m3tv)
# Used by scripts/publish.py when publishing via git
WEBSITE_REPO=/path/to/M3-org/website

# Knowledge repo path (for poster generation and RSS data lookups)
KNOWLEDGE_ROOT=/path/to/elizaOS/knowledge

# ===========================================
# FTP Publishing Configuration (Optional)
# ===========================================
# Use when running with: scripts/publish.py --target=ftp
#
# FTP server hostname (e.g., ftp.example.com)
FTP_HOST=

# FTP username
FTP_USER=

# FTP password (keep this secret! Never commit to git)
FTP_PASSWORD=

# Remote directory path on FTP server
FTP_REMOTE_PATH=/public_html/m3org/tv

# FTP port (default: 21 for FTPS)
# FTP_PORT=21

# Use FTPS (FTP over TLS) for encrypted connection (recommended)
# FTP_USE_TLS=true

# Connection timeout in seconds
# FTP_TIMEOUT=30
